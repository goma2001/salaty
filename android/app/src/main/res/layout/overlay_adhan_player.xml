<?xml version="1.0" encoding="utf-8"?>
<!-- The adhan mini player (1.0.11): what the icon-only button becomes
     for the minute after a prayer time — a small player with a sound
     wave, the prayer's name, a bar draining over that minute, and two
     buttons: mute (silence this prayer's adhan the next time it comes)
     and stop (stop the adhan playing now). Same deep emerald with a
     gold edge as the pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_player_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/overlay_player_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C9A227"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/overlay_player_wave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/overlay_player_bar1"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="3dp"
            android:background="#C9A227" />

        <View
            android:id="@+id/overlay_player_bar2"
            android:layout_width="4dp"
            android:layout_height="26dp"
            android:layout_marginEnd="3dp"
            android:background="#C9A227" />

        <View
            android:id="@+id/overlay_player_bar3"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginEnd="3dp"
            android:background="#C9A227" />

        <View
            android:id="@+id/overlay_player_bar4"
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:background="#C9A227" />

    </LinearLayout>

    <TextView
        android:id="@+id/overlay_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/overlay_player_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="1000"
        android:progressTint="#C9A227" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_player_mute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/overlay_button_outline"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#C9A227"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/overlay_player_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/overlay_button_outline"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#C9A227"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
