<?xml version="1.0" encoding="utf-8"?>
<!-- The glance card (1.0.11): what a single tap on the icon-only
     button opens — the next prayer and its live countdown, nothing
     else, with a thin bar that drains over the five seconds the card
     stays up before it closes itself. Same deep emerald with a gold
     edge as the pill and the times panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_glance_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/overlay_glance_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C9A227"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/overlay_glance_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#C9A227"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/overlay_glance_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/overlay_glance_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="1000"
        android:progressTint="#C9A227" />

</LinearLayout>
